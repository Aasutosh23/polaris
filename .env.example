# ==========================================
# Polaris IDE - Environment Variables Example
# ==========================================

# ------------------------------------------
# Clerk Authentication
# https://clerk.com
# ------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-domain.clerk.accounts.dev

# ------------------------------------------
# Convex Database & Backend
# https://convex.dev
# ------------------------------------------
CONVEX_DEPLOYMENT=dev:...
NEXT_PUBLIC_CONVEX_URL=https://...convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://...convex.site
POLARIS_CONVEX_INTERNAL_KEY=your_secure_internal_key_here

# ------------------------------------------
# AI Providers & LLM Keys
# ------------------------------------------
# Google Gemini API: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenRouter API (Access to MiniMax, Claude, GPT, etc.): https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------
# Web Scraping & Context Gathering
# https://firecrawl.dev
# ------------------------------------------
FIRECRAWL_API_KEY=fc-...

# ------------------------------------------
# Inngest Background Workflows
# https://inngest.com
# ------------------------------------------
INNGEST_DEV=true
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# ------------------------------------------
# Sentry Error Tracking (Optional)
# https://sentry.io
# ------------------------------------------
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

